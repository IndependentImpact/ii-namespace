@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix hgo:     <https://hashgraphontology.xyz/core/> .
@prefix iishape: <https://independentimpact.org/ns/shapes/> .

# ID-format constraints carried forward from the legacy hed: shapes
# (reference/ns-hedera.jsonld), re-pathed onto the Hashgraph Ontology
# properties the platform now reuses (issue #6, ns/alignments/
# hed-hashgraph.ttl). Platform-only (ADR-0002 visibility section).
#
# Not carried: the legacy HederaMessageIdShape pattern
# (^[0-9]{4,}\.[0-9]{4,}$) constrained a timestamp-string ID;
# hgo:hasConsensusTimestamp is xsd:dateTime, so the pattern no longer
# applies. The HederaNetworkNameShape enumeration (testnet, previewnet,
# mainnet) is a ns/config/ concept-scheme candidate (issue #7).

iishape:hederaAccountIdShape a sh:NodeShape ;
    skos:editorialNote "Carried from legacy hed:HederaAccountIdShape." ;
    sh:targetClass hgo:Account ;
    sh:property [
        sh:path hgo:hasAccountId ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9]{1}\\.[0-9]{1}\\.[0-9]{1,}$" ;
    ] .

iishape:hederaTopicIdShape a sh:NodeShape ;
    skos:editorialNote "Carried from legacy hed:HederaTopicIdShape." ;
    sh:targetClass hgo:ConsensusTopic ;
    sh:property [
        sh:path hgo:hasTopicId ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9]{1}\\.[0-9]{1}\\.[0-9]{1,}$" ;
    ] .
