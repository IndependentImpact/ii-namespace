@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix data:    <https://jellyfiiish.xyz/ns/> .
@prefix impact:  <https://w3id.org/impactont/> .
@prefix iiplat:  <https://independentimpact.org/ns/vocab/> .
@prefix iicfg:   <https://independentimpact.org/ns/config/> .
@prefix iishape: <https://independentimpact.org/ns/shapes/> .

# The nine SHACL shapes that were inlined in the legacy /ns/ JSON-LD
# (reference/ns.jsonld), separated from the vocabulary per ADR-0001/ADR-0002
# and carried forward as prune candidates. Platform-only (ADR-0002 visibility
# section).
#
# The legacy sh:in string enumerations are replaced by scheme-membership
# validation against the SKOS concept schemes in ns/config/ (issue #7): a
# value must be an IRI whose skos:inScheme is the named scheme. REVIEW
# ASSUMPTION: this presumes data carries concept IRIs; legacy data carried
# raw strings matching the concepts' skos:notation. If string values must
# stay valid, revert to sh:in lists of notations per shape.

iishape:userTypeShape a sh:NodeShape ;
    skos:editorialNote "Carry-forward review: values are concepts of iicfg:user-types (was inline sh:in)." ;
    sh:targetClass iiplat:PlatformUser ;
    sh:property [
        sh:path iiplat:userType ;
        sh:nodeKind sh:IRI ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue iicfg:user-types ; sh:minCount 1 ] ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

iishape:LicenseNumberShape a sh:NodeShape ;
    sh:targetClass iiplat:AgentLicense ;
    sh:property [
        sh:path iiplat:licenseNumber ;
        sh:datatype xsd:string ;
        sh:pattern "^II-(PD|PV|MV)-[0-9]{2}X[0-9]{2}X[0-9]{11}-[0-9]{8}$" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

iishape:licenseScopeShape a sh:NodeShape ;
    skos:editorialNote "Carry-forward review: values are concepts of iicfg:license-scopes (was inline sh:in)." ;
    sh:targetClass iiplat:AgentLicense ;
    sh:property [
        sh:path iiplat:licenseScope ;
        sh:nodeKind sh:IRI ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue iicfg:license-scopes ; sh:minCount 1 ] ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

iishape:resourceIpfsUriShape a sh:NodeShape ;
    skos:editorialNote "Carry-forward review: legacy shape makes resourceIpfsUri mandatory on every dcterms:Resource, contradicting the property's own 'if any' definition." ;
    sh:targetClass dcterms:Resource ;
    sh:property [
        sh:path iiplat:resourceIpfsUri ;
        sh:datatype xsd:string ;
        sh:pattern "^(ipfs|ipns)://[a-zA-Z0-9]+(?:/[a-zA-Z0-9/._-]*)?$" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

iishape:authProofShape a sh:NodeShape ;
    skos:editorialNote "Carry-forward review: values are concepts of iicfg:auth-proofs (was inline sh:in)." ;
    sh:targetClass data:Document ;
    sh:property [
        sh:path iiplat:authProof ;
        sh:nodeKind sh:IRI ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue iicfg:auth-proofs ; sh:minCount 1 ] ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

iishape:techMeasTypeShape a sh:NodeShape ;
    skos:editorialNote "Carry-forward review: values are concepts of iicfg:technology-measure-types (was inline sh:in)." ;
    sh:targetClass iiplat:TechnologyOrMeasure ;
    sh:property [
        sh:path iiplat:techMeasType ;
        sh:nodeKind sh:IRI ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue iicfg:technology-measure-types ; sh:minCount 1 ] ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

iishape:impactIntentionalityShape a sh:NodeShape ;
    skos:editorialNote "Carry-forward review: values are concepts of iicfg:impact-intentionality (was inline sh:in)." ;
    sh:targetClass impact:Impact ;
    sh:property [
        sh:path iiplat:impactIntentionality ;
        sh:nodeKind sh:IRI ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue iicfg:impact-intentionality ; sh:minCount 1 ] ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

iishape:beneficialOrAdverseShape a sh:NodeShape ;
    skos:editorialNote "Carry-forward review: values are concepts of iicfg:beneficial-adverse (was inline sh:in)." ;
    sh:targetClass impact:Impact ;
    sh:property [
        sh:path iiplat:beneficialOrAdverse ;
        sh:nodeKind sh:IRI ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue iicfg:beneficial-adverse ; sh:minCount 1 ] ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

iishape:monitoredShape a sh:NodeShape ;
    skos:editorialNote "Carry-forward review: values are concepts of iicfg:monitored (was inline sh:in) — or the property becomes boolean, retiring this shape." ;
    sh:targetClass impact:Impact ;
    sh:property [
        sh:path iiplat:monitored ;
        sh:nodeKind sh:IRI ;
        sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue iicfg:monitored ; sh:minCount 1 ] ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .
