@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://independentimpact.org/ns/config/endpoint-visibility-tiers> a skos:ConceptScheme ;
    dcterms:title "II API endpoint visibility tiers" ;
    dcterms:description "The three visibility tiers every II API endpoint falls into, per ii-backend ts-0010. Default pattern: create/update/delete/saveDraft are private; read/list is public-open." ;
    skos:hasTopConcept <https://independentimpact.org/ns/config/endpoint-visibility-tiers#private> , <https://independentimpact.org/ns/config/endpoint-visibility-tiers#public-open> , <https://independentimpact.org/ns/config/endpoint-visibility-tiers#public-permissioned> .

<https://independentimpact.org/ns/config/endpoint-visibility-tiers#private> a skos:Concept ;
    skos:inScheme <https://independentimpact.org/ns/config/endpoint-visibility-tiers> ;
    skos:topConceptOf <https://independentimpact.org/ns/config/endpoint-visibility-tiers> ;
    skos:notation "private" ;
    skos:prefLabel "Private"@en ;
    skos:definition "Reachable only by II's own front-end and internal services, on behalf of an authenticated caller who owns or administers the resource. Not for third-party integration." .

<https://independentimpact.org/ns/config/endpoint-visibility-tiers#public-open> a skos:Concept ;
    skos:inScheme <https://independentimpact.org/ns/config/endpoint-visibility-tiers> ;
    skos:topConceptOf <https://independentimpact.org/ns/config/endpoint-visibility-tiers> ;
    skos:notation "public-open" ;
    skos:prefLabel "Public (open)"@en ;
    skos:definition "No authentication required; reachable by anyone, including anonymous callers. Reserved for genuinely public information." .

<https://independentimpact.org/ns/config/endpoint-visibility-tiers#public-permissioned> a skos:Concept ;
    skos:inScheme <https://independentimpact.org/ns/config/endpoint-visibility-tiers> ;
    skos:topConceptOf <https://independentimpact.org/ns/config/endpoint-visibility-tiers> ;
    skos:notation "public-permissioned" ;
    skos:prefLabel "Public (permissioned)"@en ;
    skos:definition "Authenticated, but open to third-party callers, not just II's own UI. For information that belongs to a specific caller or that legitimate external integrations need to query directly." .
