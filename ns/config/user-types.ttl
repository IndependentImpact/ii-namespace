@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://independentimpact.org/ns/config/user-types> a skos:ConceptScheme ;
    dcterms:title "II Platform user types" ;
    dcterms:description "Types of user account on the Independent Impact platform. Values of iiplat:userType (legacy shape: userTypeShape)." ;
    skos:hasTopConcept <https://independentimpact.org/ns/config/user-types#STANDARD_REGISTRY> , <https://independentimpact.org/ns/config/user-types#USER> .

<https://independentimpact.org/ns/config/user-types#STANDARD_REGISTRY> a skos:Concept ;
    skos:inScheme <https://independentimpact.org/ns/config/user-types> ;
    skos:topConceptOf <https://independentimpact.org/ns/config/user-types> ;
    skos:notation "STANDARD_REGISTRY" ;
    skos:prefLabel "Standard registry"@en ;
    skos:definition "A user representing a standards body / standard registry." .

<https://independentimpact.org/ns/config/user-types#USER> a skos:Concept ;
    skos:inScheme <https://independentimpact.org/ns/config/user-types> ;
    skos:topConceptOf <https://independentimpact.org/ns/config/user-types> ;
    skos:notation "USER" ;
    skos:prefLabel "User"@en ;
    skos:definition "An ordinary platform user." .
