@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://independentimpact.org/ns/config/technology-measure-types> a skos:ConceptScheme ;
    dcterms:title "II technology and measure types" ;
    dcterms:description "Subtypes of technology or measure implemented by a project or activity. Values of iiplat:techMeasType (legacy shape: techMeasTypeShape)." ;
    skos:hasTopConcept <https://independentimpact.org/ns/config/technology-measure-types#FACILITY> , <https://independentimpact.org/ns/config/technology-measure-types#SYSTEM> , <https://independentimpact.org/ns/config/technology-measure-types#EQUIPMENT> , <https://independentimpact.org/ns/config/technology-measure-types#OTHER> .

<https://independentimpact.org/ns/config/technology-measure-types#FACILITY> a skos:Concept ;
    skos:inScheme <https://independentimpact.org/ns/config/technology-measure-types> ;
    skos:topConceptOf <https://independentimpact.org/ns/config/technology-measure-types> ;
    skos:notation "FACILITY" ;
    skos:prefLabel "Facility"@en .

<https://independentimpact.org/ns/config/technology-measure-types#SYSTEM> a skos:Concept ;
    skos:inScheme <https://independentimpact.org/ns/config/technology-measure-types> ;
    skos:topConceptOf <https://independentimpact.org/ns/config/technology-measure-types> ;
    skos:notation "SYSTEM" ;
    skos:prefLabel "System"@en .

<https://independentimpact.org/ns/config/technology-measure-types#EQUIPMENT> a skos:Concept ;
    skos:inScheme <https://independentimpact.org/ns/config/technology-measure-types> ;
    skos:topConceptOf <https://independentimpact.org/ns/config/technology-measure-types> ;
    skos:notation "EQUIPMENT" ;
    skos:prefLabel "Equipment"@en .

<https://independentimpact.org/ns/config/technology-measure-types#OTHER> a skos:Concept ;
    skos:inScheme <https://independentimpact.org/ns/config/technology-measure-types> ;
    skos:topConceptOf <https://independentimpact.org/ns/config/technology-measure-types> ;
    skos:notation "OTHER" ;
    skos:prefLabel "Other"@en .
